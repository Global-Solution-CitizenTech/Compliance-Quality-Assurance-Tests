# =============================================================================
# FIAP Global Solution 2026/2 - CitizenTech
# Configurações de Conexão com o Azure DevOps e GitHub
# =============================================================================

# Organização e Projeto no Azure DevOps
AZURE_DEVOPS_ORG=Global-Solution-CitizenTech
AZURE_DEVOPS_PROJECT=CitizenTech

# Personal Access Token (PAT) do Azure DevOps
# Como obter:
# 1. Acesse https://dev.azure.com/[sua-org]
# 2. Clique no ícone de perfil (canto superior direito) -> Personal access tokens
# 3. Crie um token com escopos:
#    - Work Items: Read & Write
#    - Test Management: Read & Write (para casos de teste no Azure Test Plans)
AZURE_DEVOPS_PAT=

# Organização e Repositórios GitHub
GITHUB_ORG=Global-Solution-CitizenTech
GITHUB_BASE_URL=https://github.com/Global-Solution-CitizenTech

# (Opcional) Iteration Path padrão se configurado no Azure Boards
# Ex: CitizenTech\Sprint 1
AZURE_DEVOPS_ITERATION=CitizenTech
